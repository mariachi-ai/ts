---
import Base from '../../../layouts/Base.astro';
import { designSidebar } from '../../../lib/sidebars';
import { href } from '../../../lib/url';
import { languageFacets, languageFacetValues, languageSearchText, loadDesign, loadLanguages } from '../../../loaders/design';

const catalog = loadDesign();
const languages = loadLanguages();
const categories = catalog.categories as Record<string, { label: string; description: string }>;
const facets = languageFacets(languages, categories);
const groups = Object.entries(categories)
  .map(([key, c]) => ({ key, ...c, languages: languages.filter((a) => a.category === key) }))
  .filter((g) => g.languages.length > 0);
const cssVar = (path: string) => catalog.semantic.find((t) => t.path === path)?.cssVar;
---

<Base
  title="Design languages"
  description="Complete design languages for @mariachi/design: browse by category and tags, then open each one's gallery, recipes and settings."
  sidebar={designSidebar(catalog)}
  noindex
>
  <nav class="m-breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href={href('design')}>Design</a></li>
      <li aria-current="page">Languages</li>
    </ol>
  </nav>
  <header class="x-page-header">
    <span class="x-eyebrow">@mariachi/design</span>
    <h1>{languages.length} design languages</h1>
    <p class="x-lede">
      A design language is a preset plus everything an app is built from: type, icons, chart colours, seven page recipes and a <code class="m-code-inline">DESIGN.md</code> for
      agents. Each one opens its gallery (every component in every state, light and dark), its recipes and its settings.
    </p>
    <div class="x-filter x-language-filter" data-x-filter="languages">
      <label class="m-sr-only" for="language-filter">Search languages</label>
      <input class="m-input" id="language-filter" type="search" placeholder="Search by name, feel, style or what it suits" />
      {
        facets.map((f) => (
          <>
            <label class="m-sr-only" for={`language-facet-${f.key}`}>{f.label}</label>
            <select class="m-select" data-size="sm" id={`language-facet-${f.key}`} data-x-facet={f.key}>
              <option value="">Any {f.label.toLowerCase()}</option>
              {f.options.map((o) => (
                <option value={o.value}>
                  {o.label} ({o.count})
                </option>
              ))}
            </select>
          </>
        ))
      }
      <span class="m-muted x-filter-count" data-x-count aria-live="polite">{languages.length} shown</span>
      <button type="button" class="m-button" data-variant="ghost" data-size="sm" data-x-reset hidden>Clear</button>
    </div>
  </header>

  {
    groups.map((g) => (
      <section class="x-section" data-x-group>
        <div class="m-stack" data-gap="1">
          <h2 id={g.key}>{g.label}</h2>
          <p class="m-muted">{g.description}</p>
        </div>
        <div class="m-grid" style="--m-layout-grid-min: 17rem" data-pagefind-ignore>
          {g.languages.map((a) => (
            <article
              class="x-preset-frame x-has-stretched x-language-card"
              data-theme={a.id}
              data-x-item
              data-x-text={languageSearchText(a)}
              data-x-facets={JSON.stringify(languageFacetValues(a))}
            >
              <div class="x-language-swatches" aria-hidden="true">
                {a.swatches.map((s) => (
                  <span style={`background: ${cssVar(s.path) ? `var(${cssVar(s.path)}, ${s.light})` : s.light}`} title={s.path} />
                ))}
              </div>
              <div class="m-stack" data-gap="1">
                <a class="x-stretched x-preset-name" href={href(`design/languages/${a.id}`)}>
                  {a.label}
                </a>
                <span class="m-subtle x-language-category">{[a.category, ...(a.alsoIn ?? [])].map((c) => categories[c]?.label ?? c).join(' · ')}</span>
              </div>
              <p class="x-language-pitch">{a.pitch}</p>
              <div class="m-cluster" data-gap="1">
                {[a.tags.density, a.tags.mode, ...a.tags.feel.slice(0, 3)].map((t) => (
                  <span class="m-badge">{t}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
  <p class="m-muted" data-x-empty hidden>No languages match. Try fewer filters.</p>

  <script>
    import { bindFilter } from '../../../islands/filter';
    bindFilter('languages');
  </script>
</Base>
