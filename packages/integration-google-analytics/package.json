{
  "name": "@mariachi/integration-google-analytics",
  "version": "0.0.0",
  "description": "Google Analytics 4: the page tag with Consent Mode v2, server events through the Measurement Protocol, and reports through the Data API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/integration-google-analytics"
  },
  "mariachi": {
    "category": "providers",
    "status": "alpha",
    "useWhen": "Measuring an app with Google Analytics 4: the tag on its pages, events its server sends, or reading reports",
    "entry": [
      "gtagSnippet",
      "createGoogleAnalytics",
      "gaCookies",
      "reportRows"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./gtag.js": "./browser/gtag.js",
    "./contract.json": "./contract.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "browser",
    "contract.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src browser",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/api-facade": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "jose": "^6",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@mariachi/testing": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
