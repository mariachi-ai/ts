{
  "name": "@mariachi/jobs",
  "version": "0.1.0",
  "description": "Background jobs and cron on BullMQ or Postgres, with context propagation, retries, dedup and a dead-letter queue.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/jobs"
  },
  "mariachi": {
    "category": "async",
    "status": "beta",
    "useWhen": "Work that runs later, on a schedule, or must survive restarts",
    "entry": [
      "createJobQueue",
      "defineJob",
      "DefaultJobs",
      "createPostgresJobQueue"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "require": "./dist/postgres.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "@mariachi/database": "workspace:*",
    "bullmq": "^5",
    "cron-parser": "^4.9.0",
    "zod": "^3.24"
  },
  "peerDependencies": {
    "@mariachi/database-postgres": "workspace:>=0.0.5 <1",
    "drizzle-orm": "^0.38"
  },
  "peerDependenciesMeta": {
    "@mariachi/database-postgres": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3",
    "@mariachi/database-postgres": "workspace:*",
    "drizzle-orm": "^0.38"
  }
}
