{
  "name": "@mariachi/billing-paypal",
  "version": "0.0.0",
  "description": "PayPal behind the billing port: one-time payments as orders the buyer approves and the server captures, subscriptions on billing plans with an approval link, refunds, and certificate-signed webhooks mapped to billing events.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/billing-paypal"
  },
  "mariachi": {
    "category": "domain",
    "status": "alpha",
    "useWhen": "Taking payments or subscriptions through PayPal with @mariachi/billing",
    "entry": [
      "createPayPal",
      "createPayPalBillingAdapter",
      "payPalSignature",
      "payPalWebhookAuth",
      "normalizePayPalEvent"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./contract.json": "./contract.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/billing": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@mariachi/testing": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
