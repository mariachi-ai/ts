{
  "name": "@mariachi/rate-limit",
  "version": "0.1.1",
  "description": "Rate limiting on Redis, Postgres or memory: sliding window, fixed window and token bucket, with per-tenant tiers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/rate-limit"
  },
  "mariachi": {
    "category": "security",
    "status": "beta",
    "useWhen": "Throttling callers (api-facade wires it per route) or metering per-tenant quotas",
    "entry": [
      "createRateLimiter",
      "DefaultRateLimiting",
      "PostgresRateLimiter"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "@mariachi/database": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.38",
    "ioredis": "^5"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3",
    "ioredis": "^5",
    "@mariachi/database-postgres": "workspace:*",
    "drizzle-orm": "^0.38"
  }
}
