{
  "name": "@mariachi/design",
  "version": "0.0.5",
  "description": "Framework-agnostic design library: one token contract, interchangeable presets, component CSS, and overrides at any granularity.",
  "mariachi": {
    "category": "design",
    "status": "alpha",
    "useWhen": "Styling any web app consistently, picking a preset, or overriding one token or component",
    "entry": [
      "defineTheme",
      "extendTheme",
      "defineDesign",
      "presets",
      "buildDesign",
      "checkTheme"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./mariachi.css": "./dist/css/mariachi.css",
    "./mariachi.min.css": "./dist/css/mariachi.min.css",
    "./base.css": "./dist/css/base.css",
    "./components.css": "./dist/css/components.css",
    "./components/*.css": "./dist/css/components/*.css",
    "./themes/*.css": "./dist/css/themes/*.css",
    "./tailwind.css": "./dist/css/tailwind.css",
    "./archetypes/*": "./dist/archetypes/*",
    "./behaviors": {
      "types": "./dist/behaviors.d.ts",
      "import": "./dist/behaviors.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/archetypes/gallery.css",
    "!dist/archetypes/*/gallery.html",
    "!dist/archetypes/*/recipes",
    "!dist/tokens",
    "!dist/catalog.json",
    "!dist/kits",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/generate-registry.mjs && tsup && node scripts/build-assets.mjs && node scripts/build-kits.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "node scripts/generate-registry.mjs --check && biome lint src && stylelint \"src/**/*.css\"",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "lightningcss": "^1.33.0"
  },
  "peerDependenciesMeta": {
    "lightningcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/albert-sans": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/gantari": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "lightningcss": "^1.33.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
