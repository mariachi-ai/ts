{
  "name": "@mariachi/auth-auth0",
  "version": "0.0.0",
  "description": "Auth0: token verification through the tenant's JWKS, an IdentityClient on Universal Login, the Authentication API and the Management API, and event stream webhooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/auth-auth0"
  },
  "mariachi": {
    "category": "security",
    "status": "alpha",
    "useWhen": "Using Auth0 as the identity provider",
    "entry": [
      "createAuth0Auth",
      "createAuth0IdentityClient",
      "Auth0WebhookController",
      "auth0WebhookAuth",
      "auth0LogoutUrl"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./contract.json": "./contract.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/auth": "workspace:*",
    "@mariachi/auth-oidc": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "@mariachi/server": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "jose": "^6",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@mariachi/testing": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
