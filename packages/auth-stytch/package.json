{
  "name": "@mariachi/auth-stytch",
  "version": "0.0.0",
  "description": "Stytch (Consumer): session JWTs checked locally against the project's JWKS, an IdentityClient for passwords, email codes, Google and GitHub sign-in and users, and its Svix-signed webhooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/auth-stytch"
  },
  "mariachi": {
    "category": "security",
    "status": "alpha",
    "useWhen": "Using Stytch Consumer authentication as the identity provider",
    "entry": [
      "createStytchAuth",
      "createStytchIdentityClient",
      "stytchWebhookAuth"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./contract.json": "./contract.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/auth": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "jose": "^6",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@mariachi/testing": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
