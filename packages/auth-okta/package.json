{
  "name": "@mariachi/auth-okta",
  "version": "0.0.0",
  "description": "Okta (Workforce and Customer Identity): access tokens from a custom authorization server, an IdentityClient for sign-in, refresh, sign-out and users through the Management API, and Event Hooks for WebhookServer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/auth-okta"
  },
  "mariachi": {
    "category": "security",
    "status": "alpha",
    "useWhen": "Using Okta as the identity provider: its tokens, its sign-in, its users or its Event Hooks",
    "entry": [
      "createOktaAuth",
      "createOktaIdentityClient",
      "oktaWebhookAuth",
      "oktaAuthEvents"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./contract.json": "./contract.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/auth": "workspace:*",
    "@mariachi/auth-oidc": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "@mariachi/server": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "jose": "^6",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@mariachi/testing": "workspace:*",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
