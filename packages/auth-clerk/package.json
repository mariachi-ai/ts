{
  "name": "@mariachi/auth-clerk",
  "version": "0.1.1",
  "description": "Clerk token verification and Svix-signed webhooks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariachi-ai/ts.git",
    "directory": "packages/auth-clerk"
  },
  "mariachi": {
    "category": "security",
    "status": "alpha",
    "useWhen": "Using Clerk as the identity provider",
    "entry": [
      "createClerkAuth",
      "ClerkWebhookController"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contract.json": "./contract.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clerk/backend": "^1",
    "@mariachi/auth": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "@mariachi/server": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "svix": "^1",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@mariachi/testing": "workspace:*",
    "vitest": "^3"
  }
}
